# ============================================================
# AI AutoPilot Summit — environment template
# Integration activation requires each subsystem's documented setup.
# This is a reference template, not evidence of deployed configuration.
# Keep real secrets in the platform's secure server settings, never Git.
# ============================================================

# ---------- Sales gates (browser-visible) ----------
# Master gate for ANY checkout button to activate. Must be "true".
VITE_SUMMIT_SALES_ENABLED=false
# Independent legal gate: must be "true" only after Terms, Privacy, and
# Refund Policy have been reviewed by counsel and linked publicly.
# Every isHandoffAllowed() check ALSO requires this flag.
VITE_SUMMIT_LEGAL_READY=false
# Product-specific gates. Master + legal gates are still required.
VITE_SUMMIT_UPSELLS_ENABLED=false
VITE_SUMMIT_INTENSIVE_SALES_ENABLED=false
VITE_SUMMIT_KEYNOTE_SALES_ENABLED=false
VITE_SUMMIT_MENTORSHIP_APPLICATIONS_ENABLED=false

# ---------- Owner QA review (browser-visible, no payment) ----------
# Lovable's id-preview host enables private owner review automatically.
# Set true only for an additional private review environment. QA mode forces
# every checkout handoff OFF and changes browser presentation only.
VITE_SUMMIT_QA_REVIEW=false

# ---------- Checkout URLs (browser-visible) ----------
# Full HTTPS URLs on an allowed host (defaults: www.fanbasis.com, commas.com).
# Each product is individually fail-closed: missing → button disabled.
# The four current sale products (in sequential order):
#   GA           $22     public /checkout
#   VIP_UPGRADE  $77     post-GA at /offer/vip-upgrade
#   VAULT        $199    post-VIP at /offer/implementation-vault
#   INTENSIVE    $1,000  post-Vault at /strategy-intensive (cap 10)
# Direct-VIP admission is NOT a current sale product.
VITE_COMMAS_CHECKOUT_URL_GA=
VITE_COMMAS_CHECKOUT_URL_VIP_UPGRADE=
VITE_COMMAS_CHECKOUT_URL_VAULT=
VITE_COMMAS_CHECKOUT_URL_INTENSIVE=

# Optional next-keynote checkout (renders only when both URL + date are set).
VITE_COMMAS_CHECKOUT_URL_KEYNOTE=
VITE_KEYNOTE_DATE_ISO=
VITE_KEYNOTE_PRICE_LABEL=

# Optional additional allowed hostnames (comma-separated, lowercase).
VITE_COMMAS_ALLOWED_CHECKOUT_HOSTS=

# ---------- Shopify ticket checkouts (browser-visible) ----------
# Dedicated to the /reserve → /reserve/vip → /reserve/vault funnel. Each is
# fail-closed: missing/invalid → CTA is disabled with a neutral message.
# Use permanent Shopify cart permalinks, not temporary /checkouts/cn/ sessions.
VITE_SHOPIFY_ALLOWED_CHECKOUT_HOSTS=spincityhq.com
VITE_PUBLIC_SITE_URL=https://ai-autopilot-summit.lovable.app
VITE_SHOPIFY_URL_GA=
VITE_SHOPIFY_URL_GA_VIP=
VITE_SHOPIFY_URL_GA_VIP_VAULT=

# ---------- Funnel video slots (browser-visible, optional) ----------
# YouTube or Vimeo HTTPS URL only. Empty slots are hidden publicly and remain
# visible as responsive 16:9 placeholders only in the private owner preview.
# Confirmation and audit are independent slots; only confirmation autoplays.
# Offer videos may introduce the next option. Exit videos are pure confirmation
# videos and must not sell another offer.
VITE_SUMMIT_VIDEO_HERO=https://vimeo.com/1213741553
VITE_SUMMIT_VIDEO_CHECKOUT=https://player.vimeo.com/video/1213770573?h=4e82a76d61
VITE_SUMMIT_VIDEO_VIP_OFFER=
VITE_SUMMIT_VIDEO_THANK_YOU=
VITE_SUMMIT_VIDEO_AUDIT=
VITE_SUMMIT_VIDEO_THANK_YOU_GA=
VITE_SUMMIT_VIDEO_THANK_YOU_VIP=https://player.vimeo.com/video/1213770432?h=35a1c7fcf8
VITE_SUMMIT_VIDEO_THANK_YOU_VAULT=
VITE_SUMMIT_VIDEO_THANK_YOU_INTENSIVE=
VITE_SUMMIT_VIDEO_EXIT_GA=
VITE_SUMMIT_VIDEO_EXIT_VIP=
VITE_SUMMIT_VIDEO_EXIT_VAULT=
VITE_SUMMIT_VIDEO_EXIT_INTENSIVE=

# ---------- Testimonial video slots (browser-visible, optional) ----------
# Per-funnel-stage testimonial videos. Empty → no video renders.
# Only approved-host embed URLs (YouTube / Vimeo) are accepted.
# Text testimonials themselves are configured in src/lib/testimonials.ts
# with status: "published" — nothing renders until an approved quote is added.
VITE_TESTIMONIAL_VIDEO_LANDING=
VITE_TESTIMONIAL_VIDEO_CHECKOUT=
VITE_TESTIMONIAL_VIDEO_CONFIRMED=
VITE_TESTIMONIAL_VIDEO_VIP=
VITE_TESTIMONIAL_VIDEO_VAULT=
VITE_TESTIMONIAL_VIDEO_INTENSIVE=

# ============================================================
# SERVER-ONLY (never exposed to the browser bundle)
# ============================================================

# ---------- Rate limiter (REQUIRED for sensitive endpoints) ----------
# HMAC secret used to hash the caller IP before it's written to the
# shared server-side rate-limit store. NEVER echoed, never stored raw.
# Sensitive endpoints (/api/public/resources/exchange, /read, /logout,
# and /api/public/communication-preferences) FAIL CLOSED with HTTP 503
# when this is empty. Generate with: openssl rand -hex 32
# Verify this is present in the actual server runtime; do not assume injection.
RATE_LIMIT_HMAC_SECRET=

# ---------- Commas webhook activation ----------
# Must be the literal "true" AND all 4 current-sale product IDs distinct
# AND COMMAS_WEBHOOK_SECRET non-empty, or the endpoint returns 503.
COMMAS_WEBHOOKS_ENABLED=false
COMMAS_WEBHOOK_SECRET=

# Commas / FanBasis base item IDs for the FOUR current sale products.
# Must all be present, distinct.
# Server-enforced prices (expectedTotalCents):
#   GA           $22
#   VIP_UPGRADE  $77   (sequential post-GA VIP Implementation Experience)
#   VAULT        $199  (post-VIP add-on)
#   INTENSIVE    $1,000 (post-Vault final ascension; 10 slots max)
# Direct-VIP admission is not a current sale product; new payment.succeeded
# events against a legacy VIP product ID grant nothing (reversal by
# payment_id still works for already-recorded legacy VIP purchases).
# Bundle SKUs (primary path — one payment grants all scopes atomically):
#   GA              $22   → grants ga
#   GA_VIP          $99   → grants ga, vip
#   GA_VIP_VAULT   $298   → grants ga, vip, vault
COMMAS_PRODUCT_ID_GA=
COMMAS_PRODUCT_ID_GA_VIP=
COMMAS_PRODUCT_ID_GA_VIP_VAULT=
# Intensive stays a single-product SKU (cap 10).
COMMAS_PRODUCT_ID_INTENSIVE=
# Optional legacy single-product IDs (kept working if any exist):
COMMAS_PRODUCT_ID_VIP_UPGRADE=
COMMAS_PRODUCT_ID_VAULT=


# ---------- Mailchimp adapter (all default OFF) ----------
# Requires verified sender, audience/tag IDs, and templates before flipping on.
MAILCHIMP_ENABLED=false
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SENDER_EMAIL=Sebastian@spincityhq.com

# ---------- SMS adapter (Twilio-compatible; default OFF) ----------
# Requires registered sender/short code and STOP/HELP handling.
SMS_ENABLED=false
SMS_PROVIDER=
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------- AI / prerecorded calls (default OFF) ----------
# Requires explicit seller-specific written consent, AI disclosure,
# DNC handling, and quiet-hour safeguards.
AI_CALL_ENABLED=false
AI_CALL_PROVIDER=
AI_CALL_CALLER_ID=

# ---------- Supabase (auto-managed by Lovable Cloud) ----------
# Do not paste real values here; they live in Lovable Cloud secrets.
# Listed for documentation only.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------- Owner-only audit dashboard (server-only) ----------
# Comma-separated list of buyer emails that may view /admin/audit and /admin/leads.
# Matched (case-insensitive) against the verified resource-session
# buyer_email. Leave empty to disable the dashboards entirely (routes
# return 404 for everyone).
SUMMIT_OWNER_EMAILS=

# Optional owner password for /admin/owner-login. Lets owners without a
# purchase history get a private session for the dashboards. Must be non-empty
# and SUMMIT_OWNER_EMAILS must also be set for the login page to work.
# Choose a strong passphrase; never reuse it elsewhere.
SUMMIT_OWNER_PASSWORD=


# Academy platform — all external automation remains disabled until verified.
VITE_ACADEMY_VSL_URL=
VITE_ACADEMY_VSL_SUMMIT=
VITE_ACADEMY_VSL_VAULT=
VITE_ACADEMY_VSL_ACCELERATOR=

# ---------- Vimeo lesson slots (server-only; one per slot) ----------
# Paste any Vimeo share link: vimeo.com/ID, vimeo.com/ID/HASH, vimeo.com/ID?h=HASH
# or player.vimeo.com/video/ID?h=HASH. Unlisted hashes are kept. The recording
# plays through the Vimeo player API so watch time, drop-off point and missed
# chapters feed AI Spin, the learning dashboard and the GHL coaching emails.
# Duration is confirmed server-side through Vimeo oEmbed (public/unlisted videos).
# Optional chapters: "0|Welcome;5:12|Job card;18:40|Completion receipts".
# Changing a slot's video resets viewing progress for that slot (new media version).
ACADEMY_VIMEO_FREE_WEBINAR=
ACADEMY_CHAPTERS_FREE_WEBINAR=
ACADEMY_VIMEO_BUSINESS_BEFORE_AI=
ACADEMY_CHAPTERS_BUSINESS_BEFORE_AI=
