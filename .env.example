# ---------- Timed transcripts (server-only; every word and its time for AI Spin) ----------
# Per slot, in order: ACADEMY_TRANSCRIPT_<SLOT> (HTTPS .vtt or .srt link, e.g. Vimeo's
# caption export), then ACADEMY_TRANSCRIPT_PATH_<SLOT> in the private academy-media
# bucket, then the convention transcripts/<slot-id>.vtt in that bucket (no key needed).
# Vimeo captions (auto-generated or uploaded) are pulled automatically for every Vimeo
# slot when this personal access token (scope: private, video_files) is set.
VIMEO_ACCESS_TOKEN=
# Example for the free training:
ACADEMY_TRANSCRIPT_FREE_WEBINAR=
ACADEMY_TRANSCRIPT_PATH_FREE_WEBINAR=

# ---------- Direct recordings (fallback when a slot has no Vimeo link) ----------
ACADEMY_MEDIA_FREE_WEBINAR=
ACADEMY_MEDIA_DURATION_FREE_WEBINAR=
ACADEMY_MEDIA_VERSION_FREE_WEBINAR=1
ACADEMY_CAPTIONS_FREE_WEBINAR=
ACADEMY_MEDIA_BUCKET=academy-media
# Paid example: private storage path, verified duration and media version
ACADEMY_MEDIA_PATH_BUSINESS_BEFORE_AI=
ACADEMY_MEDIA_DURATION_BUSINESS_BEFORE_AI=
ACADEMY_MEDIA_VERSION_BUSINESS_BEFORE_AI=1

# ---------- 1-on-1 booking (Accelerator members only) ----------
# HTTPS calendar link (GHL calendar, Calendly, Cal.com). Returned only to students
# with active redeemed Accelerator access; never shipped in the public bundle.
# Calendly, Cal.com and api.leadconnectorhq.com embed inline; add other hosts below.
ACADEMY_BOOKING_URL=
ACADEMY_BOOKING_EMBED_HOSTS=
# Permits activation when server database/AI/rate-limit settings work.
# Set false to switch off. This flag alone does not connect the tutor.
ACADEMY_TUTOR_ENABLED=true
ACADEMY_TUTOR_MODEL=google/gemini-3.7-flash
# Tutor runs on the managed Lovable AI Gateway using LOVABLE_API_KEY (auto-provisioned).
ACADEMY_TUTOR_DAILY_LIMIT=100
ACADEMY_SHOPIFY_ENABLED=false
ACADEMY_SHOPIFY_SHOP=
SHOPIFY_ADMIN_ACCESS_TOKEN=
ACADEMY_SHOPIFY_WEBHOOK_SECRET=
ACADEMY_SCHEDULER_SECRET=
ACADEMY_GHL_ENABLED=false
ACADEMY_GHL_WEBHOOK_URL=

# Keep off until entitlement expiry terms, media and paid/refund QA pass.
ACADEMY_PAID_ACCESS_ENABLED=false

# Purchase codes: keep disabled until Shopify, access terms and delivery pass QA.
ACADEMY_ACCESS_CODES_ENABLED=false
# Dedicated 32+ character server secret. Never expose or replace while codes are outstanding.
ACADEMY_ACCESS_CODE_SECRET=
# Per-tier approved terms only. Each entry requires hours, starts:"redemption", version.
# Empty intentionally: do not invent course duration or convert fixed-date terms to rolling access.
ACADEMY_ACCESS_TERMS_JSON={}
ACADEMY_ACCESS_EMAIL_ENABLED=false
# Separate transactional workflow; does not require marketing opt-in or an existing app account.
ACADEMY_GHL_ACCESS_WEBHOOK_URL=
# Optional progress-based coaching via existing marketing-consented GHL workflow.
ACADEMY_LEARNING_NUDGES_ENABLED=false

# AI Spin live avatar: actual HeyGen LiveAvatar account identity; server-only.
ACADEMY_AVATAR_ENABLED=false
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
ACADEMY_AVATAR_SESSION_SECONDS=300
ACADEMY_AVATAR_DAILY_SECONDS=900
