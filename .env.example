ACADEMY_CHAPTERS_HIRE_THE_AI_TEAM=
ACADEMY_VIMEO_COORDINATE_THE_BUSINESS=
ACADEMY_CHAPTERS_COORDINATE_THE_BUSINESS=
ACADEMY_VIMEO_MEASURE_THE_SYSTEM=
ACADEMY_CHAPTERS_MEASURE_THE_SYSTEM=
ACADEMY_VIMEO_OWN_THE_PLATFORM=
ACADEMY_CHAPTERS_OWN_THE_PLATFORM=
ACADEMY_VIMEO_IMPLEMENTATION_LAB=
ACADEMY_CHAPTERS_IMPLEMENTATION_LAB=
# Accelerator build rooms: one slot per day (count set by ACCELERATOR_DAY_COUNT in src/lib/academy.ts).
ACADEMY_VIMEO_ACCELERATOR_DAY_01=
ACADEMY_CHAPTERS_ACCELERATOR_DAY_01=
ACADEMY_VIMEO_ACCELERATOR_DAY_02=
ACADEMY_CHAPTERS_ACCELERATOR_DAY_02=
ACADEMY_VIMEO_ACCELERATOR_DAY_03=
ACADEMY_CHAPTERS_ACCELERATOR_DAY_03=
