# ============================================================
# AI AutoPilot Summit — environment template
# All values default to OFF / disabled. Copy this file to `.env`
# and fill in real values ONLY after each subsystem is fully
# verified. Never commit real secrets.
# ============================================================

# ---------- Sales gates (browser-visible) ----------
# Master gate for ANY checkout button to activate. Must be "true".
VITE_SUMMIT_SALES_ENABLED=false
# Independent legal gate: must be "true" only after Terms, Privacy, and
# Refund Policy have been reviewed by counsel and linked publicly.
# Every isHandoffAllowed() check ALSO requires this flag.
VITE_SUMMIT_LEGAL_READY=false
# Product-specific gates. Master + legal gates are still required.
VITE_SUMMIT_UPSELLS_ENABLED=false
VITE_SUMMIT_INTENSIVE_SALES_ENABLED=false
VITE_SUMMIT_KEYNOTE_SALES_ENABLED=false

# ---------- Checkout URLs (browser-visible) ----------
# Full HTTPS URLs on an allowed host (default: www.fanbasis.com).
# Each product is individually fail-closed: missing → button disabled.
VITE_COMMAS_CHECKOUT_URL_GA=
VITE_COMMAS_CHECKOUT_URL_VIP=
VITE_COMMAS_CHECKOUT_URL_VIP_UPGRADE=
VITE_COMMAS_CHECKOUT_URL_VAULT=
VITE_COMMAS_CHECKOUT_URL_INTENSIVE=

# Optional next-keynote checkout (renders only when both URL + date are set).
VITE_COMMAS_CHECKOUT_URL_KEYNOTE=
VITE_KEYNOTE_DATE_ISO=
VITE_KEYNOTE_PRICE_LABEL=

# Optional additional allowed hostnames (comma-separated, lowercase).
VITE_COMMAS_ALLOWED_CHECKOUT_HOSTS=

# ---------- Optional video slots (browser-visible) ----------
# HTTPS embed URLs on approved hosts only. Empty → slot hidden.
VITE_SUMMIT_VIDEO_HERO=
VITE_SUMMIT_VIDEO_THANK_YOU=

# ---------- Testimonial video slots (browser-visible, optional) ----------
# Per-funnel-stage testimonial videos. Empty → no video renders.
# Only approved-host embed URLs (YouTube / Vimeo) are accepted.
# Text testimonials themselves are configured in src/lib/testimonials.ts
# with status: "published" — nothing renders until an approved quote is added.
VITE_TESTIMONIAL_VIDEO_LANDING=
VITE_TESTIMONIAL_VIDEO_CHECKOUT=
VITE_TESTIMONIAL_VIDEO_CONFIRMED=
VITE_TESTIMONIAL_VIDEO_VIP=
VITE_TESTIMONIAL_VIDEO_VAULT=
VITE_TESTIMONIAL_VIDEO_INTENSIVE=

# ============================================================
# SERVER-ONLY (never exposed to the browser bundle)
# ============================================================

# ---------- Rate limiter (REQUIRED for sensitive endpoints) ----------
# HMAC secret used to hash the caller IP before it's written to the
# shared server-side rate-limit store. NEVER echoed, never stored raw.
# Sensitive endpoints (/api/public/resources/exchange, /read, /logout,
# and /api/public/communication-preferences) FAIL CLOSED with HTTP 503
# when this is empty. Generate with: openssl rand -hex 32
# (Lovable Cloud generates and injects this automatically.)
RATE_LIMIT_HMAC_SECRET=

# ---------- Commas webhook activation ----------
# Must be the literal "true" AND all 5 product IDs distinct AND
# COMMAS_WEBHOOK_SECRET non-empty, or the endpoint returns 503.
COMMAS_WEBHOOKS_ENABLED=false
COMMAS_WEBHOOK_SECRET=


# Commas / FanBasis base item IDs. Must all be present, distinct.
# NOTE on prices (server-enforced by expectedTotalCents):
#   GA           $22
#   VIP          $77   (legacy direct VIP; not sold from public site)
#   VIP_UPGRADE  $77   (sequential post-GA VIP Implementation Experience)
#   VAULT        $199  (post-VIP add-on)
#   INTENSIVE    $1,000 (post-Vault final ascension; 10 slots max)
COMMAS_PRODUCT_ID_GA=
COMMAS_PRODUCT_ID_VIP=
COMMAS_PRODUCT_ID_VIP_UPGRADE=
COMMAS_PRODUCT_ID_VAULT=
COMMAS_PRODUCT_ID_INTENSIVE=

# ---------- Mailchimp adapter (all default OFF) ----------
# Requires verified sender, audience/tag IDs, and templates before flipping on.
MAILCHIMP_ENABLED=false
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SENDER_EMAIL=

# ---------- SMS adapter (Twilio-compatible; default OFF) ----------
# Requires registered sender/short code and STOP/HELP handling.
SMS_ENABLED=false
SMS_PROVIDER=
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------- AI / prerecorded calls (default OFF) ----------
# Requires explicit seller-specific written consent, AI disclosure,
# DNC handling, and quiet-hour safeguards.
AI_CALL_ENABLED=false
AI_CALL_PROVIDER=
AI_CALL_CALLER_ID=

# ---------- Supabase (auto-managed by Lovable Cloud) ----------
# Do not paste real values here; they live in Lovable Cloud secrets.
# Listed for documentation only.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
